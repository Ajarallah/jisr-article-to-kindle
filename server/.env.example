# ---- Delivery service configuration ----
# Copy this file to ".env" and fill in real values. Never commit ".env".

# Port the local delivery service listens on. Must match the extension's
# "Delivery service" setting (default http://localhost:8787).
PORT=8787

# ---- Email → Kindle (SMTP) ----
# The service emails the EPUB from SENDER_EMAIL to the user's @kindle.com
# address. SENDER_EMAIL must be added to the user's Amazon
# "Approved Personal Document E-mail List" or Amazon drops the mail silently.
#
# Example for Gmail: create an App Password (not your login password) at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
SENDER_EMAIL=your-address@gmail.com

# ---- AI translation (OpenRouter) ----
# Get a key at https://openrouter.ai/keys . The model is swappable — Claude
# leads on literary Arabic tone; change OPENROUTER_MODEL to trade quality/cost.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Optional, used by OpenRouter for attribution/ranking:
OPENROUTER_REFERER=http://localhost
OPENROUTER_TITLE=Article to Kindle

# Comma-separated list of origins allowed to call this service. The Chrome
# extension origin looks like chrome-extension://<extension-id>. Leave as * for
# local testing; lock it down before exposing the service publicly.
ALLOWED_ORIGINS=*
